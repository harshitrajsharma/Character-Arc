# Copy to .env.local for development. Never commit real keys or passwords.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Prisma runtime connection; use the Supabase pooled URL for a scaled deployment.
DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/character_arc
# Direct/session connection used by Prisma migrations, not browser code.
DIRECT_URL=postgresql://postgres:replace_me@localhost:5432/character_arc

# Optional question-image uploads: server-only key and a PRIVATE storage bucket.
SUPABASE_SECRET_KEY=
SUPABASE_QUESTION_IMAGES_BUCKET=character-arc-question-images

# Optional exact HTTPS origins for browser MCP clients; never use '*'.
MCP_ALLOWED_ORIGINS=

# Optional redacted server auth diagnostics; never logs tokens, IDs or messages.
AUTH_DIAGNOSTICS=0

# Optional browser verification. Use a dedicated account in your own workspace.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_WORKSPACE_SLUG=
# The full suite creates records; keep this off for a real personal workspace.
E2E_ALLOW_MUTATIONS=0

# Optional read-only MCP endpoint verification; never put this in a URL.
MCP_API_KEY=
TEST_BASE_URL=http://127.0.0.1:3000
